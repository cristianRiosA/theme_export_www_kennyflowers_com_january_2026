{% schema %}
{
  "name": "Size Chart Grid",
  "settings": [{
      "type": "text",
      "id": "grid_title",
      "label": "Grid Title"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Size Chart Name"
        },
        {
          "type": "text",
          "id": "size_chart_id",
          "label": "Kiwi Size Chart ID"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size Chart Grid"
    }
  ]
}
{% endschema %}

<div class="size-chart-grid">
{% if section.settings.grid_title %}
  <h3>{{ section.settings.grid_title }}</h3>
{% endif %}
<div class="size-section-grid">
  {% for block in section.blocks %}
    <div id="KiwiSizingChart" 
      data-sizing-id="{{ block.settings.size_chart_id }}" 
      data-display-mode="2" 
      data-link-text="{{ block.settings.text }}"
      data-modal-header-text="{{ block.settings.text }} – Size Chart"
      data-modal-sub-header-text="">
    </div> 
  {% endfor %}
</div>
</div>


<style>
  h3 {
    width:100%;
    text-align:center;
  }

.size-chart-grid {
  margin-bottom:40px;
}
.size-section-grid {
  width: 90%;
  margin: 0 auto 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}
.size-section-grid #KiwiSizingChart {
  display:flex;
  width: 25%;
  padding:10px;
  text-align: center;
}

@media only screen and (max-width: 1000px) {
  .size-section-grid #KiwiSizingChart {
  width: 50%;
  }
}

.size-chart-grid .btn.ks-chart-modal-button span.with-icon {
  padding-left:0px !important;
}

.size-chart-grid .kiwi-svg {
  display:none;
}
  
.sizing-chart-modal-button {
  width:100%;
  height:100%;
  padding: 15px !important;
  margin-bottom: 20px;
}
</style>