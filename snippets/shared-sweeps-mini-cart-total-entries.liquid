{% assign sweeps_enabled = settings.sweeps_switch | default: true %}

{% liquid
  assign sweeps_country = localization.country.iso_code | default: '' | upcase
  assign sweeps_market_allowed = false

  if sweeps_country == 'US' or sweeps_country == 'CA'
    assign sweeps_market_allowed = true
  endif

  assign cart_obj = cart
%}

{% if sweeps_enabled and sweeps_market_allowed and cart_obj != blank %}
  {% liquid
    assign badge_font = settings.font_accent | default: settings.font_body
    assign cart_entries_total = 0

    assign currency_iso = localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency
    assign currency_iso = currency_iso | upcase

    assign currency_scale = 1.0
    if currency_iso == 'COP' or currency_iso == 'CLP' or currency_iso == 'ARS' or currency_iso == 'VND' or currency_iso == 'IDR'
      assign currency_scale = 1000.0
    endif
  %}

  {% for line_item in cart_obj.items %}
    {% liquid
      assign p = line_item.product
      assign v = line_item.variant | default: p.selected_or_first_available_variant

      assign raw_elig = p.metafields.sharedsweeps.eligibility.value | default: p.metafields.sharedsweeps.eligibility
      assign eligible = true
      if raw_elig == 'false' or raw_elig == false
        assign eligible = false
      endif
    %}

    {% if eligible %}
      {% liquid
        assign qty = line_item.quantity | default: 1

        assign priceoverride_raw = p.metafields.sharedsweeps.priceoverride.value | default: p.metafields.sharedsweeps.priceoverride
        assign shop_global_mult_raw = shop.metafields.sharedsweeps.global_multiplier.value | default: shop.metafields.sharedsweeps.global_multiplier | default: 1
        assign product_mult_raw = p.metafields.sharedsweeps.multiplier.value | default: p.metafields.sharedsweeps.multiplier
        assign bonus_raw = p.metafields.sharedsweeps.bonusEntries.value | default: p.metafields.sharedsweeps.bonusEntries | default: 0
        assign product_entry_divisor_raw = p.metafields.sharedsweeps.entry_divisor.value | default: p.metafields.sharedsweeps.entry_divisor
        assign shop_entry_divisor_raw = shop.metafields.sharedsweeps.entry_divisor.value | default: shop.metafields.sharedsweeps.entry_divisor

        assign global_mult = shop_global_mult_raw | plus: 0
        assign product_mult = product_mult_raw | plus: 0

        assign mult = global_mult
        if product_mult_raw != blank and product_mult > global_mult
          assign mult = product_mult
        endif

        assign bonus = bonus_raw | plus: 0

        assign entry_divisor_raw = product_entry_divisor_raw | default: shop_entry_divisor_raw
        if entry_divisor_raw == blank
          assign entry_divisor = currency_scale
        else
          assign entry_divisor = entry_divisor_raw | plus: 0.0
          if currency_scale == 1.0 and entry_divisor >= 1000.0
            assign entry_divisor = 1.0
          endif
          if entry_divisor <= 0
            assign entry_divisor = currency_scale
          endif
        endif

        if priceoverride_raw == blank
          assign unit_price_value = line_item.original_price | default: v.price | default: p.price
          assign base_price = unit_price_value | divided_by: 100.0 | times: qty
        else
          assign base_price = priceoverride_raw | plus: 0.0 | times: qty
        endif

        assign raw_base_entries = base_price | divided_by: entry_divisor
        assign floored_base_entries = raw_base_entries | floor
        assign decimal_remainder = raw_base_entries | minus: floored_base_entries | abs
        assign base_entries = floored_base_entries
        if decimal_remainder > 0.000001
          assign base_entries = floored_base_entries | plus: 1
        endif

        assign line_entries = base_entries | times: mult | floor

        if line_entries < 1 and base_price > 0
          assign line_entries = 1
        endif

        if bonus > 0
          assign line_entries = line_entries | plus: bonus
        endif

        assign cart_entries_total = cart_entries_total | plus: line_entries
      %}
    {% endif %}
  {% endfor %}

  {% liquid
    assign total_noun = 'ENTRIES'
    if cart_entries_total == 1
      assign total_noun = 'ENTRY'
    endif

    assign badge_id = 'shared-sweeps-mini-cart-total-entries'
  %}

  {% if cart_entries_total > 0 %}
    <div
      id="{{ badge_id }}"
      class="shared-sweeps-mini-cart-total-entries"
      data-initial-total="{{ cart_entries_total }}"
      aria-live="polite"
      role="status"
    >
      <span class="shared-sweeps-mini-cart-total-entries__label">TOTAL</span>
      <span class="shared-sweeps-mini-cart-total-entries__count">{{ cart_entries_total | number_with_delimiter }}</span>
      <span class="shared-sweeps-mini-cart-total-entries__noun">{{ total_noun }}</span>
    </div>

    <style>
      .shared-sweeps-mini-cart-total-entries{
        width:100%;
        display:flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        margin:10px 0 0;
        padding:8px 12px;
        background:#ffffff;
        border:1px solid #43c3c1;
        box-shadow:0 3px 10px rgba(67,195,193,.08);
        box-sizing:border-box;
        text-align:center;
        -webkit-font-smoothing:antialiased;
        -moz-osx-font-smoothing:grayscale;
        text-rendering:geometricPrecision;
      }

      .shared-sweeps-mini-cart-total-entries__label,
      .shared-sweeps-mini-cart-total-entries__count,
      .shared-sweeps-mini-cart-total-entries__noun{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        line-height:1;
        text-transform:uppercase;
        font-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
        font-style:normal;
        font-weight:700;
        color:#111111;
      }

      .shared-sweeps-mini-cart-total-entries__label,
      .shared-sweeps-mini-cart-total-entries__noun{
        font-size:10px;
        letter-spacing:.12em;
      }

      .shared-sweeps-mini-cart-total-entries__count{
        font-size:17px;
        letter-spacing:.04em;
      }

      @media only screen and (max-width: 767px){
        .shared-sweeps-mini-cart-total-entries{
          gap:7px;
          padding:7px 10px;
          margin-top:9px;
        }

        .shared-sweeps-mini-cart-total-entries__label,
        .shared-sweeps-mini-cart-total-entries__noun{
          font-size:9px;
          letter-spacing:.1em;
        }

        .shared-sweeps-mini-cart-total-entries__count{
          font-size:15px;
        }
      }
    </style>

    <script>
      (function() {
        var root = document.getElementById('{{ badge_id }}');
        if (!root) return;
        if (root.dataset.bound === 'true') return;
        root.dataset.bound = 'true';

        var drawer = root.closest('#CartDrawer') || document;
        var productsHolder = drawer.querySelector('[data-products]');
        var countEl = root.querySelector('.shared-sweeps-mini-cart-total-entries__count');
        var nounEl = root.querySelector('.shared-sweeps-mini-cart-total-entries__noun');

        function formatNumber(value) {
          try {
            return new Intl.NumberFormat().format(value);
          } catch(e) {
            return String(value);
          }
        }

        function parseCount(text) {
          var clean = String(text || '').replace(/[^\d]/g, '');
          if (!clean) return 0;
          return parseInt(clean, 10) || 0;
        }

        function sumLineEntries() {
          if (!productsHolder) return null;

          var countNodes = productsHolder.querySelectorAll('.shared-sweeps-mini-cart-line-entries__count');
          if (!countNodes.length) return null;

          var total = 0;
          for (var i = 0; i < countNodes.length; i++) {
            total += parseCount(countNodes[i].textContent);
          }

          return total;
        }

        function updateTotal() {
          var total = sumLineEntries();
          if (total === null) {
            total = parseInt(root.dataset.initialTotal || '0', 10) || 0;
          }

          countEl.textContent = formatNumber(total);
          nounEl.textContent = total === 1 ? 'ENTRY' : 'ENTRIES';
        }

        var rafLock = false;
        function queueUpdate() {
          if (rafLock) return;
          rafLock = true;

          requestAnimationFrame(function() {
            rafLock = false;
            updateTotal();
          });

          setTimeout(updateTotal, 60);
          setTimeout(updateTotal, 140);
          setTimeout(updateTotal, 260);
        }

        updateTotal();

        if (productsHolder) {
          productsHolder.addEventListener('change', queueUpdate, true);
          productsHolder.addEventListener('input', queueUpdate, true);
          productsHolder.addEventListener('click', function(event) {
            if (event.target.closest('.js-qty__adjust') || event.target.closest('.text-link')) {
              queueUpdate();
            }
          }, true);

          var observer = new MutationObserver(queueUpdate);
          observer.observe(productsHolder, {
            subtree: true,
            childList: true,
            characterData: true
          });
        }

        document.addEventListener('cart:updated', queueUpdate, true);
        document.addEventListener('ajaxProduct:added', queueUpdate, true);
      })();
    </script>
  {% endif %}
{% endif %}