{% assign sweeps_enabled = settings.sweeps_switch | default: true %}

{% liquid
  assign sweeps_country = localization.country.iso_code | default: '' | upcase
  assign sweeps_market_allowed = false

  if sweeps_country == 'US' or sweeps_country == 'CA'
    assign sweeps_market_allowed = true
  endif

  assign p = product
  if p == blank and item != blank
    assign p = item.product
  endif

  assign v = current_variant
  if v == blank and item != blank
    assign v = item.variant
  endif
  if v == blank and p != blank
    assign v = p.selected_or_first_available_variant
  endif
%}

{% if sweeps_enabled and sweeps_market_allowed and p != blank and v != blank %}
  {% liquid
    assign raw_elig = p.metafields.sharedsweeps.eligibility.value | default: p.metafields.sharedsweeps.eligibility
    assign eligible = true
    if raw_elig == 'false' or raw_elig == false
      assign eligible = false
    endif

    assign badge_font = settings.font_accent | default: settings.font_heading | default: settings.font_body
  %}

  {% if eligible %}
    {% liquid
      assign currency_iso = localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency
      assign currency_iso = currency_iso | upcase

      assign currency_scale = 1.0
      if currency_iso == 'COP' or currency_iso == 'CLP' or currency_iso == 'ARS' or currency_iso == 'VND' or currency_iso == 'IDR'
        assign currency_scale = 1000.0
      endif

      assign priceoverride_raw = p.metafields.sharedsweeps.priceoverride.value | default: p.metafields.sharedsweeps.priceoverride
      assign shop_global_mult_raw = shop.metafields.sharedsweeps.global_multiplier.value | default: shop.metafields.sharedsweeps.global_multiplier | default: 1
      assign product_mult_raw = p.metafields.sharedsweeps.multiplier.value | default: p.metafields.sharedsweeps.multiplier
      assign bonus_raw = p.metafields.sharedsweeps.bonusEntries.value | default: p.metafields.sharedsweeps.bonusEntries | default: 0
      assign product_entry_divisor_raw = p.metafields.sharedsweeps.entry_divisor.value | default: p.metafields.sharedsweeps.entry_divisor
      assign shop_entry_divisor_raw = shop.metafields.sharedsweeps.entry_divisor.value | default: shop.metafields.sharedsweeps.entry_divisor

      assign global_mult = shop_global_mult_raw | plus: 0
      assign product_mult = product_mult_raw | plus: 0

      assign mult = global_mult
      if product_mult_raw != blank and product_mult > global_mult
        assign mult = product_mult
      endif

      assign bonus = bonus_raw | plus: 0

      assign entry_divisor_raw = product_entry_divisor_raw | default: shop_entry_divisor_raw
      if entry_divisor_raw == blank
        assign entry_divisor = currency_scale
      else
        assign entry_divisor = entry_divisor_raw | plus: 0.0
        if currency_scale == 1.0 and entry_divisor >= 1000.0
          assign entry_divisor = 1.0
        endif
        if entry_divisor <= 0
          assign entry_divisor = currency_scale
        endif
      endif

      if priceoverride_raw == blank
        assign unit_price_value = v.price | default: p.price
        assign base_price = unit_price_value | divided_by: 100.0
      else
        assign base_price = priceoverride_raw | plus: 0.0
      endif

      assign raw_base_entries = base_price | divided_by: entry_divisor
      assign floored_base_entries = raw_base_entries | floor
      assign decimal_remainder = raw_base_entries | minus: floored_base_entries | abs
      assign base_entries = floored_base_entries

      if decimal_remainder > 0.000001
        assign base_entries = floored_base_entries | plus: 1
      endif

      assign entries = base_entries | times: mult | floor

      if entries < 1 and base_price > 0
        assign entries = 1
      endif

      if bonus > 0
        assign entries = entries | plus: bonus
      endif

      assign noun = 'ENTRIES'
      if entries == 1
        assign noun = 'ENTRY'
      endif

      assign mult_label = mult | round: 2 | append: '' | replace: '.0', ''
      assign sweeps_helper_text = 'Every $1 = 1 entry to the Dream Vacation Giveaway'

      assign show_multiplier = false
      if mult > 1
        assign show_multiplier = true
      endif
    %}

    {% if base_price > 0 %}
      <div
        class="shared-sweeps-image-badge{% if show_multiplier %} shared-sweeps-image-badge--has-mult{% endif %}"
        aria-label="Earn {{ entries | number_with_delimiter }} {{ noun | downcase }}"
      >
        <span class="shared-sweeps-image-badge__copy">
          <span class="shared-sweeps-image-badge__prefix">EARN</span>
          <span class="shared-sweeps-image-badge__count">{{ entries | number_with_delimiter }}</span>
          <span class="shared-sweeps-image-badge__noun">{{ noun }}</span>

          <span
            class="shared-sweeps-image-badge__info-wrap"
            aria-label="{{ sweeps_helper_text }}"
          >
            <span class="shared-sweeps-image-badge__info-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false" aria-hidden="true">
                <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
                <circle cx="8" cy="4.7" r="1" fill="currentColor"></circle>
                <path d="M8 7.2V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </span>

            <span class="shared-sweeps-image-badge__tooltip">{{ sweeps_helper_text }}</span>
          </span>
        </span>

        {% if show_multiplier %}
          <span class="shared-sweeps-image-badge__mult">{{ mult_label }}×</span>
        {% endif %}
      </div>

      <style>
        .product-card--featured-image-link {
          position: relative;
          overflow: hidden;
          isolation: isolate;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge {
          --sweeps-accent: #88b5b0;
          --sweeps-text: #66707a;
          position: absolute;
          left: 50%;
          bottom: 10px;
          transform: translateX(-50%) translateZ(0);
          z-index: 1001;
          display: inline-grid;
          grid-template-columns: auto;
          align-items: stretch;
          width: max-content;
          max-width: calc(100% - 20px);
          min-height: 32px;
          background: rgba(255, 255, 255, 0.98);
          border: 1px solid var(--sweeps-accent);
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
          overflow: visible;
          box-sizing: border-box;
          pointer-events: none;
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
          text-rendering: geometricPrecision;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge--has-mult {
          grid-template-columns: auto auto;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__copy {
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: max-content;
          align-items: center;
          justify-content: center;
          column-gap: 5px;
          min-width: 0;
          padding: 0 12px;
          background: rgba(255, 255, 255, 0.98);
          color: var(--sweeps-text);
          white-space: nowrap;
          text-align: center;
          font-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
          font-style: normal;
          font-weight: 700;
          line-height: 1;
          box-sizing: border-box;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__prefix,
        .product-card--featured-image-link .shared-sweeps-image-badge__noun,
        .product-card--featured-image-link .shared-sweeps-image-badge__count {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 13px;
          line-height: 1;
          letter-spacing: .04em;
          text-transform: uppercase;
          font-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
          font-style: normal;
          font-weight: 700;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__prefix,
        .product-card--featured-image-link .shared-sweeps-image-badge__noun {
          color: var(--sweeps-text);
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__count {
          min-width: auto;
          color: var(--sweeps-accent);
          letter-spacing: .01em;
          text-align: center;
          font-variant-numeric: lining-nums tabular-nums;
          font-feature-settings: "lnum" 1, "tnum" 1;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__info-wrap {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          align-self: center;
          width: 16px;
          min-width: 16px;
          height: 16px;
          margin-left: 4px;
          pointer-events: auto;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__info-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 16px;
          min-width: 16px;
          height: 16px;
          color: var(--sweeps-accent);
          line-height: 0;
          box-sizing: border-box;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__info-icon svg {
          display: block;
          width: 16px;
          height: 16px;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__tooltip {
          position: absolute;
          left: 50%;
          bottom: calc(100% + 10px);
          transform: translateX(-50%);
          z-index: 1002;
          width: max-content;
          min-width: 240px;
          max-width: calc(100% + 80px);
          padding: 10px 12px;
          background: rgba(255, 255, 255, 0.98);
          border: 1px solid var(--sweeps-accent);
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
          color: var(--sweeps-text);
          font-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
          font-style: normal;
          font-weight: 700;
          font-size: 13px;
          line-height: 1.35;
          letter-spacing: .01em;
          text-transform: none;
          white-space: normal;
          text-align: center;
          box-sizing: border-box;
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition: opacity 0.18s ease, visibility 0.18s ease;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__info-wrap:hover .shared-sweeps-image-badge__tooltip,
        .product-card--featured-image-link .shared-sweeps-image-badge__info-wrap:focus-within .shared-sweeps-image-badge__tooltip {
          opacity: 1;
          visibility: visible;
        }

        .product-card--featured-image-link .shared-sweeps-image-badge__mult {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 0;
          padding: 0 12px 0 10px;
          background: rgba(255, 255, 255, 0.98);
          color: var(--sweeps-accent);
          border-left: 1px solid var(--sweeps-accent);
          text-align: center;
          font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
          font-style: normal;
          font-weight: 600;
          font-size: 15px;
          line-height: 1;
          letter-spacing: 0;
          text-transform: none;
          font-variant-numeric: lining-nums tabular-nums;
          font-feature-settings: "lnum" 1, "tnum" 1;
          box-sizing: border-box;
        }

        .product-card--featured-image:has(.toggle_size_preview_fit) .product-card--featured-image-link .shared-sweeps-image-badge {
          bottom: 46px;
        }

        @media only screen and (max-width: 767px) {
          .product-card--featured-image-link .shared-sweeps-image-badge {
            left: 10px;
            right: 10px;
            bottom: 10px;
            transform: translateZ(0);
            width: auto;
            max-width: none;
            min-height: 28px;
            grid-template-columns: minmax(0, 1fr);
          }

          .product-card--featured-image-link .shared-sweeps-image-badge--has-mult {
            grid-template-columns: minmax(0, 1fr) auto;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__copy {
            grid-auto-columns: max-content;
            column-gap: 4px;
            padding: 0 8px;
            justify-content: center;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__prefix {
            display: none;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__noun,
          .product-card--featured-image-link .shared-sweeps-image-badge__count {
            font-size: 11px;
            letter-spacing: .03em;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__info-wrap {
            width: 14px;
            min-width: 14px;
            height: 14px;
            margin-left: 4px;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__info-icon {
            width: 14px;
            min-width: 14px;
            height: 14px;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__info-icon svg {
            width: 14px;
            height: 14px;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__tooltip {
            left: 8px;
            right: 8px;
            bottom: calc(100% + 8px);
            transform: none;
            width: auto;
            min-width: 0;
            max-width: none;
            padding: 10px 12px;
            font-size: 12px;
            line-height: 1.35;
          }

          .product-card--featured-image-link .shared-sweeps-image-badge__mult {
            min-width: 0;
            padding: 0 8px 0 6px;
            font-size: 12px;
            font-weight: 600;
          }

          .product-card--featured-image:has(.toggle_size_preview_fit) .product-card--featured-image-link .shared-sweeps-image-badge {
            bottom: 44px;
          }
        }
      </style>
    {% endif %}
  {% endif %}
{% endif %}