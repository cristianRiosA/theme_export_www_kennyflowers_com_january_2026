dolim-Beach.mp4","overlay_opacity":25,"disable_top_spacing":true,"disable_bottom_spacing":true}},"d85a4eda-e48a-42a2-a551-11df8925ba8c":{"type":"rich-text","blocks":{"template--16794398884059__d85a4eda-e48a-42a2-a551-11df8925ba8c-text-1":{"type":"text","settings":{"text":"<p>We’re in the business of helping others loosen up a bit, whether that’s losing a button when the clock strikes 5, or winning back the freedom they deserve after working hard all week. We’ve been turning vacation shirts into a lifestyle for a few years now and we need you to help keep things groovin’ when it comes to bringing KF to the next level.<\/p><p>We are committed to fostering, cultivating and preserving a culture of diversity and inclusion. Our employees are the most valuable asset we have. The collective sum of the individual differences, life experiences, knowledge, inventiveness, innovation, self-expression, unique capabilities and talent that our employees invest in their work represents a significant part of not only our culture, but our reputation and company’s achievement as well.<\/p>","size":"text-size-regular"}},"83e10ad7-fc53-4945-a63d-003a0ff91afc":{"type":"heading","settings":{"text":"BENEFITS OF WORKING AT KENNY FLOWERS","size":"h4"}}},"block_order":["template--16794398884059__d85a4eda-e48a-42a2-a551-11df8925ba8c-text-1","83e10ad7-fc53-4945-a63d-003a0ff91afc"],"settings":{"section_width":"grid","text_width":"grid","text_position":"center","text_alignment":"center","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":false,"disable_bottom_spacing":true}},"ae0fd682-6838-4f32-a342-e8c2160a2e5b":{"type":"text-with-icons","blocks":{"template--16794398884059__ae0fd682-6838-4f32-a342-e8c2160a2e5b-icon-1":{"type":"icon","settings":{"icon":"ruler","image":"shopify:\/\/shop_images\/insurance-plans.png","heading":"COMPREHENSIVE HEALTH, VISION AND DENTAL PLANS","text":""}},"template--16794398884059__ae0fd682-6838-4f32-a342-e8c2160a2e5b-icon-2":