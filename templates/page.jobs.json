ipe":true,"color_bg":"rgba(0,0,0,0)","color_heading":"#151515","color_text":"#151515","disable_top_spacing":false,"disable_bottom_spacing":false}},"d8100d39-0228-460b-afa3-0525f08f114e":{"type":"rich-text","blocks":{"template--16794398884059__d8100d39-0228-460b-afa3-0525f08f114e-heading-1":{"type":"heading","settings":{"text":"OUR JOB OPENINGS","size":"h4"}}},"block_order":["template--16794398884059__d8100d39-0228-460b-afa3-0525f08f114e-heading-1"],"settings":{"section_width":"grid","text_width":"medium","text_position":"center","text_alignment":"center","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":true,"disable_bottom_spacing":true}},"9c626d92-1b5d-49e1-beb3-d909be9d2241":{"type":"custom-liquid","settings":{"custom_liquid":"<div style=\"width:80%;margin:0 auto 0;\"><object type=\"text\/html\" data=\"https:\/\/kenny-flowers.myshopify.com\/a\/careers\/widget\" width=\"100%\" height=\"500px\"><\/object><\/div>"}},"7f36831b-01b0-45b8-97c6-1f5c8fb76e39":{"type":"rich-text","blocks":{"template--16794398884059__7f36831b-01b0-45b8-97c6-1f5c8fb76e39-heading-1":{"type":"heading","settings":{"text":"WHAT YOU’LL LOVE ABOUT US","size":"h4"}},"template--16794398884059__7f36831b-01b0-45b8-97c6-1f5c8fb76e39-text-1":{"type":"text","settings":{"text":"<ul><li>Great company culture & work\/life balance. We believe that it’s easier to enjoy yourself in your free time when you know you’ve worked hard and achieved something great at work. We’re here to make sure you feel challenged, inspired, and excited by your job, every day. And to give you lots of reasons to celebrate.<\/li><li>Small team, growing biz - this ain’t a corporate job. You’re going to have lots of responsibility from the get-go and you’re going to help make a lot happen with Kenny Flowers. You’ll be working with a small, energized team that feels more like a family.<\/li><li>Champagne Moments - each week, we believe there’s an achievable goal worth celebrating. We put our hands up for each other when we reach it<\/li><li>Overall, we’re helping people have a good time, and we have a great time doing it<\/li><\/ul>","size":"text-size-regular"}}},"block_order":["template--16794398884059__7f36831b-01b0-45b8-97c6-1f5c8fb76e39-heading-1","template--16794398884059__7f36831b-01b0-45b8-97c6-1f5c8fb76e39-text-1"],"settings":{"section_width":"full-width-row","text_width":"grid","text_position":"center","text_alignment":"left","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":true,"disable_bottom_spacing":true}},"29e9dbea-35fb-413f-bc2a-4c759604d899":{"type":"rich-text","blocks":{"template--16794398884059__29e9dbea-35fb-413f-bc2a-4c759604d899-heading-1":{"type":"heading","settings":{"text":"“100% OF THE SHIRTS YOU DON’T MAKE, DON’T GET WORN.”","size":"h4"}},"template--16794398884059__29e9dbea-35fb-413f-bc2a-4c759604d899-subheading-1":{"type":"subheading","settings":{"text":"– Kenny Flowers"}}},"block_order":["template--16794398884059__29e9dbea-35fb-413f-bc2a-4c759604d899-heading-1","template--16794398884059__29e9dbea-35fb-413f-bc2a-4c759604d899-subheading-1"],"settings":{"section_width":"full-width-row","text_width":"large","text_position":"center","text_alignment":"center","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":true,"disable_bottom_spacing":false}},"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":false,"disable_top_spacing":false,"disable_bottom_spacing":false}}},"order":["41210be8-ea89-4a1d-b722-996d0bddd679","5101f268-83a3-4203-b6aa-a3a254119741","d85a4eda-e48a-42a2-a551-11df8925ba8c","ae0fd682-6838-4f32-a342-e8c2160a2e5b","10e408c0-caa9-40f1-9542-9c4ff375fdc2","d8100d39-0228-460b-afa3-0525f08f114e","9c626d92-1b5d-49e1-beb3-d909be9d2241","7f36831b-01b0-45b8-97c6-1f5c8fb76e39","29e9dbea-35fb-413f-bc2a-4c759604d899","main"]}