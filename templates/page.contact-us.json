{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":true,"disable_top_spacing":false,"disable_bottom_spacing":false}},"1661619382b4020fa2":{"type":"rich-text","blocks":{"166161938159ca8988-1":{"type":"heading","settings":{"text":"CONTACT US","size":"h2"}},"166161938159ca8988-2":{"type":"text","settings":{"text":"","size":"text-size-regular"}}},"block_order":["166161938159ca8988-1","166161938159ca8988-2"],"settings":{"section_width":"grid","text_width":"medium","text_position":"center","text_alignment":"center","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":false,"disable_bottom_spacing":true}},"1652268757b7c53383":{"type":"contact-form","disabled":true,"settings":{"heading":"","description":"","show_phone_number":true,"disable_top_spacing":true,"disable_bottom_spacing":false}},"052f6c39-c0f0-4116-87a1-4ad14e1ef78f":{"type":"custom-liquid","custom_css":[".tab {overflow: hidden; display: flex; justify-content: center; padding: 0px 0px 20px;}",".tab button {background-color: inherit; float: left; border: none; outline: none; cursor: pointer; padding: 14px 16px; transition: 0.3s; border-radius: 4px; margin-right: 20px; background: white; border: 1px solid #d2d2d2;}",".tablinks:last-of-type {margin-right: 0px;}",".tab button:hover {background-color: #ddd;}",".tab button.active {background-color: #333; color: white;}",".tabcontent {display: none; padding: 6px 12px; border: 0px solid #ccc; border-top: none;}"],"settings":{"custom_liquid":"<!-- Tab links -->\n<div class=\"tab\">\n  <button class=\"tablinks active\" onclick=\"openTab(event, 'Orders')\">Order Inquiries<\/button>\n  <button class=\"tablinks\" onclick=\"openTab(event, 'General')\">General Questions<\/button>\n  <button class=\"tablinks\" onclick=\"openTab(event, 'Wholesale')\">Wholesale<\/button>\n<\/div>\n\n<!-- Tab content -->\n<div id=\"Orders\" class=\"tabcontent\" style=\"display:block;\">\n  <div class=\"globo-formbuilder\" data-id=\"Nzg1OTM=\"><\/div>\n<\/div>\n\n<div id=\"General\" class=\"tabcontent\">\n  <div class=\"globo-formbuilder\" data-id=\"Nzg1OTU=\"><\/div>\n<\/div>\n\n<div id=\"Wholesale\" class=\"tabcontent\">\n  <div class=\"globo-formbuilder\" data-id=\"Nzg1OTk=\"><\/div>\n<\/div>\n\n<script>\nfunction openTab(evt, tabName) {\n  \/\/ Declare all variables\n  var i, tabcontent, tablinks;\n\n  \/\/ Get all elements with class=\"tabcontent\" and hide them\n  tabcontent = document.getElementsByClassName(\"tabcontent\");\n  for (i = 0; i < tabcontent.length; i++) {\n    tabcontent[i].style.display = \"none\";\n  }\n\n  \/\/ Get all elements with class=\"tablinks\" and remove the class \"active\"\n  tablinks = document.getElementsByClassName(\"tablinks\");\n  for (i = 0; i < tablinks.length; i++) {\n    tablinks[i].className = tablinks[i].className.replace(\" active\", \"\");\n  }\n\n  \/\/ Show the current tab, and add an \"active\" class to the button that opened the tab\n  document.getElementById(tabName).style.display = \"block\";\n  evt.currentTarget.className += \" active\";\n}\n<\/script>"}},"a76e350d-9bff-404d-ac2e-4b9adb3d2f13":{"type":"spacer","settings":{"spacer_mobile":50,"spacer_desktop":100,"border_separator":false,"border_separator_full":false}}},"order":["main","1661619382b4020fa2","1652268757b7c53383","052f6c39-c0f0-4116-87a1-4ad14e1ef78f","a76e350d-9bff-404d-ac2e-4b9adb3d2f13"]}