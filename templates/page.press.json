e_EDttwr"],"custom_css":[".btn--secondary {display: inline-block; background: black; color: white; padding: 10px 20px; border-radius: 2px; margin-top: 4px; margin-bottom: 4px; font-family: \"SaaSeries - FD\"; font-weight: 300; font-size: 14px;}"],"settings":{}},"9679cfab-e208-4af1-b5b5-8bfcef02a9bf":{"type":"custom-liquid","disabled":true,"custom_css":["h2,h3 {font-family: \"SaaSeries - CD\"; font-weight: 300;}","h3 {font-size: 22px; line-height: 26px;}","@media only screen and (max-width: 600px) {.press-story {flex-direction: column; }}",".btn--secondary {display: inline-block; background: black; color: white; padding: 10px 20px; border-radius: 2px; margin-top: 4px; margin-bottom: 4px; font-family: \"SaaSeries - FD\"; font-weight: 300; font-size: 14px;}"],"settings":{"custom_liquid":"<div class=\"container-fluid press-large\" style=\"width:80%;margin:0 auto -40px;\">\n  <h2 style=\"text-align:center;\">Featured Press<\/h2>\n\n\n  <div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-1\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/forbes-logo-black-transparent.png?v=1613667373\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">This Is How One Pink Shirt Can Change The Entire Way You Think About Your Life<\/h3>\n      <p style=\"font-size:18px;color:#444\">That’s what Hawaiians have always been about—for my grandfather, for Jimmy Buffett, and for Kenny. Life is serious. Work hard, stay inspired, pursue your dreams. But remember it's not that hard to enjoy yourself along the way with two buttons down.<\/p>\n      <a href=\"https:\/\/www.forbes.com\/sites\/petertaylor\/2019\/02\/01\/this-is-how-one-pink-shirt-can-change-the-entire-way-you-think-about-your-life\/#4c83594c460c\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n  <div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-img-golf\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/golfweek-logo-dark.png?v=1649021871\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">Hawaiian-themed golf apparel that even allows men and women to match on the course<\/h3>\n      <p style=\"font-size:18px;color:#444\">Golf took off in 2020 as a great socially-distanced activity, and Kenny Flowers aims to fill a void in the golf apparel industry by launching the first line of high-quality matching golf shirts for both men and women.<\/p>\n      <a href=\"https:\/\/golfweek.usatoday.com\/2021\/07\/23\/kenny-flowers-golf-apparel-hawaiian-theme\/\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n<div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-t-l\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/travel-leisure.png?v=1627441726\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">Covid Affect Your Wedding Plans? Here's How You Can Win a Dream Honeymoon<\/h3>\n      <p style=\"font-size:18px;color:#444\">Kenny Flowers wants to make sure a few lucky couples get to experience their dream honeymoon even if they couldn’t experience their dream wedding just yet.<\/p>\n      <a href=\"https:\/\/www.travelandleisure.com\/trip-ideas\/honeymoon-destinations\/kenny-flowers-honeymoon-contest\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n<div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-4\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/New-York-Times-Logo.png?v=1649021871\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">We Can Still Travel — With Photoshop and a Dream<\/h3>\n      <p style=\"font-size:18px;color:#444\">There’s little choice now but to stay grounded because of the coronavirus, but avid travelers are devising creative and meaningful ways to celebrate the vacations they have had to cancel.<\/p>\n      <a href=\"https:\/\/www.nytimes.com\/2020\/04\/07\/travel\/coronavirus-fake-travel.html\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n  <div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-2\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/forbes-logo-black-transparent.png?v=1613667373\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">8 Smaller Brands That Are Helping During The Covid Crisis<\/h3>\n      <p style=\"font-size:18px;color:#444\">As a small business, Kenny Flowers is determined to make a big difference in the US and the global battle against COVID-19.<\/p>\n      <a href=\"https:\/\/www.forbes.com\/sites\/meimeifox\/2020\/05\/05\/7-smaller-brands-that-are-helping-during-the-covid-crisis\/#63bfd0e16d1d\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n  <div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-3\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/brobible-logo.png?v=1613667366\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">Kenny Flowers Hawaiian Shirts Are The Ultimate Summer Party Shirt<\/h3>\n      <p style=\"font-size:18px;color:#444\"> Great Hawaiian shirts like the ones from Kenny Flowers effortlessly transition between day and night – You can roll up to the pool or the dance floor wearing the same Aloha shirt. And they’re ultra lightweight, hanging loose and mellow on your body, like the men’s clothing equivalent of Bob Marley’s “Three Little Birds” at a tropical happy hour.\n\n <\/p>\n      <a href=\"https:\/\/www.forbes.com\/sites\/petertaylor\/2019\/02\/01\/this-is-how-one-pink-shirt-can-change-the-entire-way-you-think-about-your-life\/#4c83594c460c\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n  <div class=\"row press-story\" style=\"background:white;border-radius:4px;box-shadow:0px 0px 10px 1px rgba(0,0,0,0.1);\">\n    <div class=\"col-sm-12 col-md-4 press-feature-bg-img press-5\" style=\"position:relative\">\n<div class=\"darken\"><\/div>\n<img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0804\/1709\/files\/wedding-chicks-logo-black.png?v=1649021871\">\n<\/div>\n    <div class=\"col-sm-12 col-md-8\" style=\"padding:20px;\">\n      <h3 style=\"margin-bottom:15px;\">This Is the New Bachelorette Uniform You’ll Need to Have This Year<\/h3>\n      <p style=\"font-size:18px;color:#444\">You’ll have every other baching bride rethinking her ‘Out of Office’ floppy hats and tribe-twinning towels. Plus, the design and quality of Kenny Flowers’ fashions is SO GOOD, you’ll absolutely find yourself breaking out your sarong wrap again for your friend’s destination wedding, summers in the Hamptons, or your own honeymoon.\n\n <\/p>\n      <a href=\"https:\/\/www.weddingchicks.com\/blog\/this-is-the-new-bachelorette-uniform-youll-need-to-have-this-year-l-18053-l-53.html\" target=\"_blank\" class=\"btn btn--secondary\">Read Full Article<\/a>\n    <\/div>\n  <\/div>\n\n<\/div>"}},"98665e00-371f-4e42-b5ae-19d333ff6cb5":{"type":"spacer","settings":{"spacer_mobile":20,"spacer_desktop":20,"border_separator":false,"border_separator_full":false}},"press_articles_gwXKem":{"type":"press-articles","blocks":{"press_article_A3qT66":{"type":"press-article","settings":{"press_logo_image":"shopify:\/\/shop_images\/Cosmopolitan-Emblem.png","press_title":"Best White Swimsuits That Aren't Sheer (Promise!)","press_url":"https:\/\/www.kennyflowers.com\/collections\/watercolors-swimwear?filter.p.m.custom.color=White"}},"press_article_QqgLf8":{"type":"press-article","settings":{"press_logo_image":"shopify:\/\/shop_images\/forbes-logo-black-transparent.png","press_title":"The Best Dresses For Traveling Moms","press_url":"shopify:\/\/collections\/dresses"}},"press_article_be4JJE":{"type":"press-article","settings":{"press_logo_image":"shopify:\/\/shop_images\/The-Miami-Herald-Logo_svg.png","press_title":"The Best Men’s Cabana Sets for Summer: A Great Father’s Day Gift","press_url":"shopify:\/\/collections\/mens-cabana-sets"}},"press_article_TUDhzU":{"type":"press-article","settings":{"press_logo_image":"shopify:\/\/shop_images\/brobible-logo_b6ba2707-98be-4893-8bb3-46bf1a811e32.png","press_title":"Look Your Best This Summer In These New Kenny Flowers Swim Trunks","press_url":"https:\/\/www.google.com\/url?q=https:\/\/brobible.com\/gear\/article\/brobible-essentials-look-your-best-this-summer-in-these-new-kenny-flowers-swim-trunks\/&sa=D&source=editors&ust=1715793163753931&usg=AOvVaw0ggPYT6jDEJhFskbvk4hlB"}},"press