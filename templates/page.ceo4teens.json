{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":true,"disable_top_spacing":false,"disable_bottom_spacing":false}},"166161901464a25e50":{"type":"image-with-text-overlay","blocks":{"166161901437c6bc67-1":{"type":"heading","settings":{"text":"Welcome to Paradise","heading_size":"h1-large"}},"166161901437c6bc67-2":{"type":"text","disabled":true,"settings":{"text":"<p>Our Generation are looking to create a clothing brand that is massively focused on being sustainable and ethical.<\/p>","description_size":"medium"}}},"block_order":["166161901437c6bc67-1","166161901437c6bc67-2"],"disabled":true,"settings":{"section_width":"full-width-row-full","image":"shopify:\/\/shop_images\/kenny-flowers-labor-day-sale-cover_1.jpg","image_parallax":false,"desktop_height":"desktop-height-450","mobile_height":"mobile-height-500","content_width":"medium","content_position":"middle-center","text_alignment":"center","overlay_opacity":20,"disable_top_spacing":true,"disable_bottom_spacing":false}},"16616191162185f622":{"type":"rich-text","blocks":{"1661619116558a03c6-1":{"type":"heading","settings":{"text":"CEO4TEENS","size":"h2"}},"81aef71b-ff93-4baf-ac6a-79cb1c7e3f08":{"type":"text","settings":{"text":"<p>We know that with great shirts comes great responsibility. By choosing to buy from Kenny Flowers, you’re fueling a small, family business that gives back every step of the way. <br\/><br\/>Through our ongoing partnership with CEO4Teens, an education foundation started by Kenny in 2007, we have sent more than 150 students to college in Bali, and sponsored GED (high school equivalency) tests for more than 100 underprivileged Americans since 2015.<\/p>","size":"text-size-regular"}}},"block_order":["1661619116558a03c6-1","81aef71b-ff93-4baf-ac6a-79cb1c7e3f08"],"settings":{"section_width":"grid","text_width":"large","text_position":"center","text_alignment":"center","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":false,"disable_bottom_spacing":true}},"16521210505e7fc635":{"type":"image-with-text","blocks":{"fdde343c-11c7-492a-86ab-c3f9adc62f3f":{"type":"heading","settings":{"text":"What is CEO4TEENS","heading_size":"h3"}},"5c23121f-d034-4e43-9da0-f63cca2746e0":{"type":"text","settings":{"text":"<p>CEO4Teens is a nonprofit organization on a mission to create educational opportunities for financially-disadvantaged teenagers and young adults throughout the world.CEO4Teens believes that no individual should be denied the opportunity to get a practical education due to economic restrictions. We aim to knock down the barriers preventing motivated, hard-working young adults from reaching their educational, career and life goals, by enabling them to get the education they deserve.<\/p>","description_size":"medium"}},"b1bb057f-62ba-4239-a792-dec2a68621a9":{"type":"image","disabled":true,"settings":{"retina":true}},"35ba44fe-0dfa-463a-920a-d0df404ab526":{"type":"space","disabled":true,"settings":{"height":48}},"100ac1ce-4a1c-45fd-9648-02b517aa76d1":{"type":"image","disabled":true,"settings":{"retina":true}}},"block_order":["fdde343c-11c7-492a-86ab-c3f9adc62f3f","5c23121f-d034-4e43-9da0-f63cca2746e0","b1bb057f-62ba-4239-a792-dec2a68621a9","35ba44fe-0dfa-463a-920a-d0df404ab526","100ac1ce-4a1c-45fd-9648-02b517aa76d1"],"settings":{"image":"shopify:\/\/shop_images\/Kenny-Haisfield-Founder-Kenny-Flowers.jpg","use_video":false,"video":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","video_autoplay":true,"video_controls":true,"height":"adapt","desktop_image_width":"medium","section_width":"grid","layout":"text_first","content_position":"text-left","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_border":"#e2e2e2","disable_top_spacing":true,"disable_bottom_spacing":true}},"d1fa4f66-f139-4aa5-a0bb-8fc4991254a3":{"type":"rich-text","blocks":{"template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-subheading-1":{"type":"subheading","disabled":true,"settings":{"text":"Subheading for this section"}},"template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-heading-1":{"type":"heading","settings":{"text":"Talk about your brand","size":"h3"}},"template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-text-1":{"type":"text","settings":{"text":"<p><strong>Continue Education<\/strong><br\/>The scholarship program helps financially disadvantaged teenagers continue their education<\/p><p><strong>Realize Dreams<\/strong><br\/>The alum of our program open their worlds and realize their dreams with new English, computer and leadership skills<\/p><p><strong>Alleviate Poverty<\/strong><br\/>New levels of income and opportunity improve financial standings of our alum and their families<\/p><p><strong>Give Back<\/strong><br\/>In their free time, CEO4Teens students and alum are constantly giving back - teaching English and values to the younger children of their villages and communities.<\/p>","size":"text-size-regular"}},"template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-button-1":{"type":"button","settings":{"link_label":"Learn More","link":"","button_outline":false}}},"block_order":["template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-subheading-1","template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-heading-1","template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-text-1","template--16794591166683__d1fa4f66-f139-4aa5-a0bb-8fc4991254a3-button-1"],"settings":{"section_width":"grid","text_width":"grid","text_position":"center","text_alignment":"left","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_links":"#151515","disable_top_spacing":false,"disable_bottom_spacing":false}},"ee48a9a9-a54f-4b57-a1c6-8dc7a6e06af9":{"type":"video","settings":{"heading":"","heading_left":false,"description":"","section_width":"full-width-row","video":"https:\/\/www.youtube.com\/watch?v=FjPO_YU6etc","video_autoplay":false,"aspect_ratio":"16-9","disable_top_spacing":false,"disable_bottom_spacing":false}},"2af3fe75-1594-4c7f-9ae1-a8c182d58781":{"type":"image-with-text","blocks":{"template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-subheading-1":{"type":"subheading","disabled":true,"settings":{"text":"Add a tagline"}},"template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-heading-1":{"type":"heading","disabled":true,"settings":{"text":"Image with text","heading_size":"h3"}},"7c184657-1bdb-4418-a9fb-c6fdba3995c0":{"type":"heading","settings":{"text":"In America","heading_size":"h3"}},"template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-text-1":{"type":"text","settings":{"text":"<p>CEO4Teens currently partners with X-Cel Education to help underprivileged young adults in America obtain their GEDs. Since 2015, we have awarded over 100 scholarships to young men and women in the area to cover GED exam fees and help them receive their high school diploma equivalency.<br\/><br\/>Our GED program has helped 100+ students afford the GED test - removing a major financial hurdle and giving those that deserve it a second chance to achieve their dreams and advance their careers. We’re determined to expand our education-focused efforts in the states and help further improve economic opportunities where they are needed.<\/p>","description_size":"medium"}}},"block_order":["template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-subheading-1","template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-heading-1","7c184657-1bdb-4418-a9fb-c6fdba3995c0","template--16794398785755__2af3fe75-1594-4c7f-9ae1-a8c182d58781-text-1"],"settings":{"image":"shopify:\/\/shop_images\/ged-boston-ceo4teens-2.jpeg","use_video":false,"video":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","video_autoplay":true,"video_controls":true,"height":"adapt","desktop_image_width":"medium","section_width":"grid","layout":"image_first","content_position":"text-left","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_border":"#e2e2e2","disable_top_spacing":true,"disable_bottom_spacing":false}},"77dfbcd6-24d8-44cc-b938-aebac50ec21d":{"type":"image-with-text","blocks":{"template--16782970093787__77dfbcd6-24d8-44cc-b938-aebac50ec21d-heading-1":{"type":"heading","settings":{"text":"MAKING A REAL DIFFERENCE","heading_size":"h3"}},"template--16782970093787__77dfbcd6-24d8-44cc-b938-aebac50ec21d-text-1":{"type":"text","settings":{"text":"<p>CEO4Teens currently partners with X-Cel Education to help underprivileged young adults in America obtain their GEDs. Since 2015, we have awarded over 100 scholarships to young men and women in the area to cover GED exam fees and help them receive their high school diploma equivalency.<br\/><br\/>Our GED program has helped 100+ students afford the GED test - removing a major financial hurdle and giving those that deserve it a second chance to achieve their dreams and advance their careers. We’re determined to expand our education-focused efforts in the states and help further improve economic opportunities where they are needed.<\/p>","description_size":"medium"}}},"block_order":["template--16782970093787__77dfbcd6-24d8-44cc-b938-aebac50ec21d-heading-1","template--16782970093787__77dfbcd6-24d8-44cc-b938-aebac50ec21d-text-1"],"settings":{"image":"shopify:\/\/shop_images\/ged-boston-3.jpeg","use_video":false,"video":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","video_autoplay":true,"video_controls":true,"height":"adapt","desktop_image_width":"small","section_width":"grid","layout":"text_first","content_position":"text-left","color_bg":"rgba(0,0,0,0)","color_text":"#151515","color_border":"#e2e2e2","disable_top_spacing":true,"disable_bottom_spacing":false}},"ba044d08-ea46-4f5f-bcc1-b14997af0ce9":{"type":"image-with-text-overlay","blocks":{"template--16794398785755__ba044d08-ea46-4f5f-bcc1-b14997af0ce9-subheading-1":{"type":"subheading","disabled":true,"settings":{"text":"Add a tagline"}},"template--16794398785755__ba044d08-ea46-4f5f-bcc1-b14997af0ce9-heading-1":{"type":"heading","settings":{"text":"KENNY FLOWERS