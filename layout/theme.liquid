	{{ content_for_header }} <!-- Header hook for plugins -->

	<script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

  <script src="{{ 'timesact.js' | asset_url }}" defer="defer"></script>
  <script>
window.addEventListener('DOMContentLoaded', (event) => {
    // Find the anchor element with class "back_button"
    const backButton = document.querySelector('a.back_button');

    // If the anchor element is found, replace its href attribute
    if (backButton) {
        backButton.href = '/pages/careers';
    }
});
</script>

